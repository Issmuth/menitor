{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Issmuth/menitor/blob/main/core/schemas/plan.schema.json",
  "title": "Menitor plan (.menitor/plan.json)",
  "description": "Milestones, tasks, checklists, done-when criteria and owners. Written by the agent through the menitor CLI.",
  "type": "object",
  "required": ["version", "project", "approvedAt", "milestones"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "project": { "$ref": "#/$defs/project" },
    "checks": { "$ref": "#/$defs/checks" },
    "approvedAt": { "type": ["string", "null"] },
    "milestones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/milestone" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "line": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\n\\r`]*$" },
    "project": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/line" },
        "type": { "enum": ["web"] },
        "summary": { "type": "string", "maxLength": 600 },
        "stack": { "type": "array", "items": { "$ref": "#/$defs/line" }, "uniqueItems": true },
        "hosting": { "type": ["string", "null"], "maxLength": 100 },
        "deployUrl": { "type": ["string", "null"], "pattern": "^https?://" }
      }
    },
    "checks": {
      "description": "Project-wide deterministic commands. Each runs before any AI review.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": { "type": ["string", "null"], "maxLength": 300 },
        "lint": { "type": ["string", "null"], "maxLength": 300 },
        "test": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "milestone": {
      "type": "object",
      "required": ["id", "title", "tasks"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/line" },
        "goal": { "$ref": "#/$defs/line" },
        "skeleton": { "type": "boolean" },
        "branch": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._/-]+$" },
        "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "goal", "why", "docs", "owner", "checklist", "doneWhen", "hints", "hintsRevealed", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "goal": { "$ref": "#/$defs/line" },
        "why": { "$ref": "#/$defs/line" },
        "docs": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\s`]+$" },
        "learn": {
          "type": "object",
          "required": ["label"],
          "additionalProperties": false,
          "properties": {
            "label": { "$ref": "#/$defs/line" },
            "url": { "type": ["string", "null"], "pattern": "^https?://" }
          }
        },
        "focus": { "type": "array", "items": { "$ref": "#/$defs/line" }, "uniqueItems": true },
        "owner": { "enum": ["learner", "delegated"] },
        "skipped": { "type": "boolean" },
        "branch": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._/-]+$" },
        "checklist": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checklistItem" } },
        "doneWhen": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/line" } },
        "verify": { "type": "array", "items": { "$ref": "#/$defs/verifyStep" } },
        "hints": {
          "anyOf": [
            { "type": "null" },
            { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/hint" } }
          ]
        },
        "hintsRevealed": { "type": "integer", "minimum": 0, "maximum": 4 },
        "status": { "enum": ["todo", "done"] },
        "passedAt": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"], "maxLength": 2000 },
        "added": { "type": ["string", "null"], "description": "When the task joined the approved plan; absent on tasks from setup." }
      }
    },
    "checklistItem": {
      "type": "object",
      "required": ["id", "text", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}\\.[cf][0-9]{1,3}$" },
        "text": { "$ref": "#/$defs/line" },
        "source": { "enum": ["plan", "fix"] }
      }
    },
    "verifyStep": {
      "description": "A task-specific deterministic check: a shell command, or an HTTP request to a deployed URL.",
      "anyOf": [
        {
          "type": "object",
          "required": ["run"],
          "additionalProperties": false,
          "properties": {
            "run": { "type": "string", "minLength": 1, "maxLength": 300 },
            "label": { "$ref": "#/$defs/line" }
          }
        },
        {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "pattern": "^(https?://|\\$deployUrl)" },
            "status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "contains": { "type": "string", "maxLength": 200 },
            "label": { "$ref": "#/$defs/line" }
          }
        }
      ]
    },
    "hint": {
      "type": "object",
      "required": ["rung", "text"],
      "additionalProperties": false,
      "properties": {
        "rung": { "enum": ["concept", "approach", "pseudocode", "snippet"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}
