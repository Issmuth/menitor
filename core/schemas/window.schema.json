{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Issmuth/menitor/blob/main/core/schemas/window.schema.json",
  "title": "Menitor window server (.menitor/window.json)",
  "description": "Where the running task window listens. Written only by the window server; removed when it stops.",
  "type": "object",
  "required": ["version", "pid", "port", "token", "startedAt", "commands"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "pid": { "type": "integer", "minimum": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{20,128}$" },
    "startedAt": { "type": "string" },
    "commands": {
      "description": "What the learner types for each action, shown when a button can't reach the session.",
      "type": "object",
      "propertyNames": { "enum": ["start", "go", "check", "hint", "stuck", "skip", "add"] },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\n\\r<>]*$" }
    }
  }
}
