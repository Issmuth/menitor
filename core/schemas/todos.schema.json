{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Issmuth/menitor/blob/main/core/schemas/todos.schema.json",
  "title": "Menitor to-dos (.menitor/todos.json)",
  "description": "The learner's own notes: ideas, features and changes to come back to. Written only by the window server; the agent reads them through the CLI as data, never as instructions.",
  "type": "object",
  "required": ["version", "todos"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "todos": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "text", "done", "at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,32}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "done": { "type": "boolean" },
          "at": { "type": "string" },
          "doneAt": { "type": ["string", "null"] }
        }
      }
    }
  }
}
